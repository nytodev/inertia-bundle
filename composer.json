{
    "name": "nytodev/inertia-bundle",
    "description": "Symfony Bundle implementing the Inertia.js v3 server-side protocol",
    "type": "symfony-bundle",
    "keywords": ["symfony", "inertia", "inertiajs", "bundle", "spa", "react", "vue", "svelte"],
    "homepage": "https://github.com/nytodev/inertia-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Tony Blard",
            "email": "tonyblard55@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "symfony/http-client": "Needed when ssr_enabled is true — provides the http_client service used by HttpSsrGateway.",
        "symfony/serializer": "Needed when passing a serialization context to Inertia::render() — normalizes PHP objects in props.",
        "symfony/validator": "Needed for automatic interception of MapRequestPayload/MapQueryString validation errors into Inertia error props."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.65",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nytodev\\InertiaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nytodev\\InertiaBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "^6.4 || ^7.0 || ^8.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
